        {
          "seconds": 0.04365700000198558,
          "stream": "stdout",
          "text": "def vote(flags, threshold=3):"
        },
        {
          "seconds": 0.048236000002361834,
          "stream": "stdout",
          "text": "    flags = tuple(flags)"
        },
        {
          "seconds": 0.04824116700910963,
          "stream": "stdout",
          "text": "    if not flags or any(type(x) is not int or x not in (0, 1) for x in flags):"
        },
        {
          "seconds": 0.04824350000126287,
          "stream": "stdout",
          "text": "        raise ValueError(\"Flags must be non-empty binary integers\")"
        },
        {
          "seconds": 0.048245249985484406,
          "stream": "stdout",
          "text": "    if type(threshold) is not int or not 1 <= threshold <= len(flags):"
        },
        {
          "seconds": 0.04824712499976158,
          "stream": "stdout",
          "text": "        raise ValueError(\"Threshold must be within the panel size\")"
        },
        {
          "seconds": 0.04824883400578983,
          "stream": "stdout",
          "text": "    return int(sum(flags) >= threshold)"
        },
        {
          "seconds": 0.04825062499730848,
          "stream": "stdout",
          "text": ""
        },
        {
          "seconds": 0.048252624983433634,
          "stream": "stdout",
          "text": "def triage(flags):"
        },
        {
          "seconds": 0.048254458990413696,
          "stream": "stdout",
          "text": "    # Validation is shared with the ordinary classifier."
        },
        {
          "seconds": 0.04825608400278725,
          "stream": "stdout",
          "text": "    vote(flags, 3)"
        },
        {
          "seconds": 0.04825766698922962,
          "stream": "stdout",
          "text": "    if len(flags) != 5:"
        },
        {
          "seconds": 0.04825933399843052,
          "stream": "stdout",
          "text": "        raise ValueError(\"The prespecified triage rule requires five flags\")"
        },
        {
          "seconds": 0.04826108398265205,
          "stream": "stdout",
          "text": "    count = sum(flags)"
        },
        {
          "seconds": 0.04826275000232272,
          "stream": "stdout",
          "text": "    return \"auto_accept\" if count <= 1 else \"auto_flag\" if count >= 4 else \"review\""
        },
        {
          "seconds": 0.04826445900835097,
          "stream": "stdout",
          "text": ""
        }
      ]
